# Database
# For Neon (hosted): postgresql://user:password@host/dbname?sslmode=require
# For Docker: postgresql://cron:cron@db:5432/cron
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Auth.js
AUTH_SECRET="generate-with-openssl-rand-base64-33"
AUTH_TRUST_HOST=true
AUTH_URL=""

# Callback: https://site.com/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

CRON_SECRET="generate-any-random-string-here"

# Base URL (used for generating ping URLs)
# Baked into browser code at build time; rebuild the image after changing it.
NEXT_PUBLIC_BASE_URL=""

# Loopback-only app port; match the upstream in C:\Caddy\Caddyfile.
APP_PORT=3010

# useSend (email alerts and scheduled reminders)
USESEND_API_KEY=""
USESEND_BASE_URL=""
USESEND_FROM_EMAIL=""